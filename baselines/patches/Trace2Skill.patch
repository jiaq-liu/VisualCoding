+"""Gemini (google-genai) clients for Trace2Skill's analysis and skill-evolution stages.
+
+Upstream Trace2Skill talks to OpenAI-compatible endpoints: the skill evolver through
+`OpenAIClient.chat(messages, settings)` and the LLM analysis scripts through the raw
+`openai` SDK (`client.chat.completions.create`).  This module provides both shapes on top
+of the shared google-genai wrapper, so `--llm-client gemini` / `--llm_client gemini` runs
+the published pipeline with gemini-3.1-pro and no OpenAI-compatible endpoint in the middle.
+"""
+from __future__ import annotations
+
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+_BASELINES = Path(__file__).resolve().parents[3]          # .../verifier/baselines
+if str(_BASELINES) not in sys.path:
+    sys.path.insert(0, str(_BASELINES))
+
+from common.gemini import Gemini                           # noqa: E402
+
+DEFAULT_MAX_TOKENS = 16384
+
+
+class GeminiClient:
+    """`OpenAIClient`-shaped client for the skill evolver."""
+
+    def __init__(self, model: str = "gemini-3.1-pro-preview", api_key: str | None = None,
+                 base_url: str | None = None, cache_path: str | None = None,
+                 use_cache: bool = False, generation_config: dict | None = None,
+                 retry_times: tuple[int, ...] = (5, 10, 30), timeout: float | None = 600.0,
+                 **kwargs):
+        self.model = model
+        self.generation_config = dict(generation_config or {})
+        self.n_calls = 0
+        self._lm = Gemini(model=model, api_key=api_key, retries=len(retry_times) + 1,
+                          timeout_s=timeout or 600.0,
+                          temperature=float(self.generation_config.get("temperature", 0.6)),
+                          top_p=float(self.generation_config.get("top_p", 1.0)),
+                          max_tokens=int(self.generation_config.get("max_tokens", DEFAULT_MAX_TOKENS)))
+
+    def chat(self, messages, settings=None, return_reasoning: bool = False):
+        msgs = [{"role": getattr(m, "role", None) or m["role"],
+                 "content": getattr(m, "content", None) or m["content"]} for m in messages]
+        temp = getattr(settings, "temperature", None) if settings else None
+        max_tokens = getattr(settings, "max_tokens", None) if settings else None
+        # The evolver's ModelSettings defaults (temperature 0.7) are overridden by an explicit
+        # generation_config, matching how the OpenAI client is configured for these runs.
+        if "temperature" in self.generation_config:
+            temp = self.generation_config["temperature"]
+        if "max_tokens" in self.generation_config:
+            max_tokens = self.generation_config["max_tokens"]
+        self.n_calls += 1
+        text = self._lm.generate(msgs, temperature=temp, max_tokens=max_tokens or DEFAULT_MAX_TOKENS)
+        return (text, "") if return_reasoning else text
+
+    async def chat_async(self, messages, settings=None):
+        return self.chat(messages, settings)
+
+
+# --------------------------------------------------------------------------- openai shim
+@dataclass
+class _Message:
+    content: str
+
+
+@dataclass
+class _Choice:
+    message: _Message
+
+
+@dataclass
+class _Response:
+    choices: list
+
+
+class _Completions:
+    def __init__(self, lm: Gemini):
+        self._lm = lm
+
+    def create(self, model: str | None = None, messages: list | None = None, **kwargs) -> _Response:
+        lm = self._lm if not model or model == self._lm.model else Gemini(
+            model=model, temperature=self._lm.temperature, max_tokens=self._lm.max_tokens)
+        text = lm.generate(messages or [],
+                           temperature=kwargs.get("temperature"),
+                           max_tokens=kwargs.get("max_tokens"))
+        return _Response(choices=[_Choice(message=_Message(content=text))])
+
+
+class _Chat:
+    def __init__(self, lm: Gemini):
+        self.completions = _Completions(lm)
+
+
+class GeminiOpenAIShim:
+    """Minimal `openai.OpenAI`-shaped object: `.chat.completions.create(...)`."""
+
+    def __init__(self, model: str = "gemini-3.1-pro-preview", api_key: str | None = None,
+                 temperature: float = 0.6, max_tokens: int = DEFAULT_MAX_TOKENS, **kwargs):
+        self._lm = Gemini(model=model, api_key=api_key, temperature=temperature, max_tokens=max_tokens)
+        self.chat = _Chat(self._lm)
