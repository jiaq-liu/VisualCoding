@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""
+Minimal skill format checker used by the skill evolver's apply/validate phase.
+
+Validates that a skill directory contains a SKILL.md with YAML frontmatter
+declaring `name` and `description`. Prints issues and exits non-zero on
+failure, mirroring the interface of the upstream skill-creator validator.
+"""
+
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+
+def validate(skill_dir: Path) -> list[str]:
+    errors = []
+    skill_md = skill_dir / "SKILL.md"
+    if not skill_md.is_file():
+        return [f"SKILL.md not found in {skill_dir}"]
+
+    content = skill_md.read_text(encoding="utf-8", errors="replace")
+    if not content.strip():
+        return ["SKILL.md is empty"]
+
+    frontmatter_match = re.match(r"^---\s*\n(.*?)\n---\s*\n(.*)", content, re.DOTALL)
+    if not frontmatter_match:
+        return ["SKILL.md must start with YAML frontmatter delimited by ---"]
+
+    frontmatter, body = frontmatter_match.group(1), frontmatter_match.group(2)
+
+    name_match = re.search(r'^name:\s*["\']?([^"\'\n]+)["\']?\s*$', frontmatter, re.MULTILINE)
+    if not name_match:
+        errors.append("frontmatter is missing a `name:` field")
+    elif not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", name_match.group(1).strip()):
+        errors.append(f"skill name should be kebab-case, got: {name_match.group(1).strip()!r}")
+
+    if not re.search(r"^description:\s*\S", frontmatter, re.MULTILINE):
+        errors.append("frontmatter is missing a `description:` field")
+
+    if not body.strip():
+        errors.append("SKILL.md has no body content after the frontmatter")
+
+    return errors
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        print("Usage: quick_validate.py <skill_dir>", file=sys.stderr)
+        return 2
+    skill_dir = Path(sys.argv[1])
+    errors = validate(skill_dir)
+    if errors:
+        for err in errors:
+            print(f"ERROR: {err}")
+        return 1
+    print(f"OK: {skill_dir / 'SKILL.md'} passed format checks")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
