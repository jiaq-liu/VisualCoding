+++ b/skillopt/envs/visqa/adapter.py
@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+from skillopt.datasets.base import BatchSpec
+from skillopt.envs.base import EnvAdapter
+from skillopt.envs.visqa.dataloader import VisQADataLoader
+from skillopt.envs.visqa.rollout import run_batch
+
+
+class VisQAAdapter(EnvAdapter):
+    """Same shape as the built-in benchmarks; the rollout goes to the shared executor."""
+
+    def __init__(self, split_dir: str = "", data_path: str = "", split_mode: str = "split_dir",
+                 split_ratio: str = "2:1:7", split_seed: int = 42, split_output_dir: str = "",
+                 max_turns: int = 20, exec_timeout: int = 120, workers: int = 8,
+                 analyst_workers: int = 8, failure_only: bool = False, minibatch_size: int = 8,
+                 edit_budget: int = 4, seed: int = 42, limit: int = 0, rollouts: int = 4,
+                 model: str = "", image_root: str = "", max_completion_tokens: int = 8192) -> None:
+        self.max_turns = max_turns
+        self.exec_timeout = exec_timeout
+        self.workers = workers
+        self.rollouts = int(rollouts)
+        self.model = model or None
+        self.image_root = image_root
+        self.max_completion_tokens = int(max_completion_tokens)
+        self.analyst_workers = analyst_workers
+        self.failure_only = failure_only
+        self.minibatch_size = minibatch_size
+        self.edit_budget = edit_budget
+        self.dataloader = VisQADataLoader(
+            split_dir=split_dir, data_path=data_path, split_mode=split_mode,
+            split_ratio=split_ratio, split_seed=split_seed, split_output_dir=split_output_dir,
+            seed=seed, limit=limit)
+
+    def setup(self, cfg: dict) -> None:
+        cfg = dict(cfg or {})
+        if self.image_root:
+            cfg.setdefault("image_root", self.image_root)
+        super().setup(cfg)
+        self.dataloader.setup(cfg)
+
+    def get_dataloader(self):
+        return self.dataloader
+
+    def build_env_from_batch(self, batch: BatchSpec, **kwargs):
+        return list(batch.payload or [])
+
+    def build_train_env(self, batch_size: int, seed: int, **kwargs):
+        return self.build_env_from_batch(
+            self.dataloader.build_train_batch(batch_size=batch_size, seed=seed, **kwargs), **kwargs)
+
+    def build_eval_env(self, env_num: int, split: str, seed: int, **kwargs):
+        return self.build_env_from_batch(
+            self.dataloader.build_eval_batch(env_num=env_num, split=split, seed=seed, **kwargs), **kwargs)
+
+    def rollout(self, env_manager, skill_content: str, out_dir: str, **kwargs) -> list[dict]:
+        return run_batch(items=list(env_manager), out_root=out_dir, skill_content=skill_content,
+                         max_turns=self.max_turns, workers=self.workers, rollouts=self.rollouts,
+                         model=self.model, max_completion_tokens=self.max_completion_tokens)
+
+    def get_task_types(self) -> list[str]:
+        seen: list[str] = []
+        for item in (self.dataloader.train_items + self.dataloader.val_items
+                     + self.dataloader.test_items):
+            t = str(item.get("task_type") or "visqa")
+            if t not in seen:
+                seen.append(t)
+        return seen or ["visqa"]
diff --git a/skillopt/envs/visqa/dataloader.py b/skillopt/envs/visqa/dataloader.py
new file mode 100644
index 0000000..04c4432
--- /dev/null
+++ b/skillopt/envs/visqa/dataloader.py
@@ -0,0 +1,46 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from skillopt.datasets.base import SplitDataLoader
+
+
+def _normalize(rec: dict, image_root: Path) -> dict:
+    """data_split record -> SkillOpt item (the raw record is kept for the executor)."""
+    question = str(rec.get("problem") or "").replace("<image>", "").strip()
+    images = [str(image_root / p) for p in rec.get("images", [])]
+    family = str(rec.get("family") or "visqa")
+    return {
+        "id": str(rec["doc_id"]),
+        "question": question,
+        "answer": str(rec.get("solution", "")),
+        "answers": [str(rec.get("solution", ""))],
+        "task_type": family,
+        "subtask": family,
+        "dataset": str(rec.get("dataset") or rec.get("data_source") or ""),
+        "image_paths": images,
+        "image_path": images[0] if images else "",
+        "record": rec,
+    }
+
+
+class VisQADataLoader(SplitDataLoader):
+    """Loads every data_split json in a split directory (train/ val/ test/)."""
+
+    def load_split_items(self, split_path: str) -> list[dict]:
+        path = Path(split_path)
+        files = sorted(path.glob("*.json"))
+        if not files:
+            raise FileNotFoundError(f"No .json file found in {split_path}")
+        image_root = Path(self._cfg.get("image_root")) if getattr(self, "_cfg", None) and \
+            self._cfg.get("image_root") else Path(path.parent / "image_root")
+        items: list[dict] = []
+        for f in files:
+            for rec in json.loads(f.read_text()):
+                items.append(_normalize(rec, image_root))
+        return items
+
+    def setup(self, cfg: dict) -> None:            # keep the config for image_root resolution
+        self._cfg = dict(cfg or {})
+        super().setup(cfg)
diff --git a/skillopt/envs/visqa/evaluator.py b/skillopt/envs/visqa/evaluator.py
new file mode 100644
index 0000000..d64e066
--- /dev/null
+++ b/skillopt/envs/visqa/evaluator.py
@@ -0,0 +1,15 @@
+"""Scoring for visqa.
+
+Scores come from the study's judge (the same LLM judge every arm uses), applied inside the
+executor; a rollout's `accuracy_score` is already 0/1 per rollout.  `aggregate` turns the
+per-rollout scores of one task into SkillOpt's (hard, soft) pair.
+"""
+from __future__ import annotations
+
+
+def aggregate(scores: list[float]) -> tuple[int, float]:
+    """hard = the task is solved by the majority of its rollouts; soft = mean accuracy."""
+    if not scores:
+        return 0, 0.0
+    soft = sum(scores) / len(scores)
+    return int(soft >= 0.5), float(soft)
diff --git a/skillopt/envs/visqa/rollout.py b/skillopt/envs/visqa/rollout.py
new file mode 100644
index 0000000..46a1937
--- /dev/null
+++ b/skillopt/envs/visqa/rollout.py
@@ -0,0 +1,76 @@
+"""visqa rollouts: the shared code-interpreter executor, not a chat call.
+
+`run_batch` keeps SkillOpt's contract (results.jsonl rows + a per-item conversation.json for
+the reflection stage) but produces the rollouts with `common.executor`, so SkillOpt's skill
+document is trained against exactly the agent, tool, turn budget and judge that XSkill,
+Trace2Skill and the main method use — and the empty-skill pass is reused from earlier runs.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from pathlib import Path
+
+_BASELINES = Path(__file__).resolve().parents[4]                 # .../verifier/baselines
+if str(_BASELINES) not in sys.path:
+    sys.path.insert(0, str(_BASELINES))
+
+from common import executor, traj                                 # noqa: E402
+from skillopt.envs.visqa.evaluator import aggregate               # noqa: E402
+
+
+def _conversation(trajs: list) -> list[dict]:
+    """The reflection stage reads this: the agent's turns with the code it actually ran."""
+    out = []
+    for t in sorted(trajs, key=lambda x: x.rollout):
+        out.append({"type": "rollout", "rollout": t.rollout, "correct": bool(t.success),
+                    "final_answer": t.final_answer, "content": t.render(with_header=False)})
+    return out
+
+
+def run_batch(items: list[dict], out_root: str, skill_content: str, *, max_turns: int = 20,
+              exec_timeout: int = 120, workers: int = 8, rollouts: int = 4,
+              model: str | None = None, max_completion_tokens: int = 8192,
+              diagnostic_mode: bool = False, diagnostic_instruction: str = "",
+              task_timeout: int = 1800, **kwargs) -> list[dict]:
+    del exec_timeout, diagnostic_mode, diagnostic_instruction, task_timeout, kwargs
+    os.makedirs(out_root, exist_ok=True)
+    recs = [it["record"] for it in items]
+    spec = executor.ExecSpec(model=model or executor.MODEL, rollouts=rollouts, workers=workers,
+                             max_turns=max_turns, max_tokens=max_completion_tokens)
+    run_dir = Path(out_root) / "rollouts"
+    executor.run(recs, run_dir, skill_text=(skill_content or None), spec=spec)
+
+    by_task = traj.group_by_task(traj.load_run(run_dir))
+    rows = []
+    for it in items:
+        ts = by_task.get(it["id"], [])
+        hard, soft = aggregate([float(t.accuracy or 0.0) for t in ts])
+        pred = ts[0].final_answer if ts else ""
+        # `predictions/<task_id>/` is where the analyst looks (gradient/reflect.py:
+        # fmt_minibatch_trajectories reads <prediction_dir>/<id>/conversation.json, and the
+        # trainer passes <rollout_dir>/predictions).  Writing one level up means the analyst
+        # silently sees no trajectories, returns 0 edits without ever calling the model, and
+        # the step is skipped -- which is exactly how the first real run produced 33 empty
+        # skills.  Same layout as the shipped docvqa env.
+        pred_dir = Path(out_root) / "predictions" / it["id"]
+        pred_dir.mkdir(parents=True, exist_ok=True)
+        (pred_dir / "conversation.json").write_text(
+            json.dumps(_conversation(ts), ensure_ascii=False, indent=1))
+        (pred_dir / "target_system_prompt.txt").write_text(skill_content or "")
+        (pred_dir / "target_user_prompt.txt").write_text(it["question"])
+        rows.append({
+            "id": it["id"], "question": it["question"],
+            "task_type": it.get("subtask") or it.get("task_type") or "visqa",
+            "task_description": it["question"], "hard": hard, "soft": soft,
+            "predicted_answer": pred or "", "response": (ts[0].render(with_header=False) if ts else ""),
+            "fail_reason": "" if ts else "no-rollout", "agent_ok": bool(ts),
+            "n_turns": (len(ts[0].turns) if ts else 0), "image_paths": it.get("image_paths", []),
+            "gold_answer": it.get("answers", []), "phase": "done" if ts else "error",
+            "n_rollouts": len(ts),
+        })
+    with open(os.path.join(out_root, "results.jsonl"), "w", encoding="utf-8") as f:
+        for r in rows:
+            f.write(json.dumps(r, ensure_ascii=False) + "\n")
+    return rows
diff --git a/skillopt/envs/visqa/skills/README.md b/skillopt/envs/visqa/skills/README.md
new file mode 100644
index 0000000..1ce9bc2
--- /dev/null
+++ b/skillopt/envs/visqa/skills/README.md
@@ -0,0 +1,11 @@
+`initial.md` is intentionally EMPTY.
+
+The env passes the skill straight through to the shared executor as
+`--system-prompt-extra`, and `common/executor.py` drops a falsy skill entirely.  An empty
+initial skill therefore makes step 1's system prompt byte-identical to the no-skill prompt
+of the acq runs, so the whole first (and, under the single-pass protocol, only) rollout pass
+is served from the existing rollout pool instead of being paid for again.  It also puts
+SkillOpt on the same cold start as XSkill and Trace2Skill, which begin with no skill.
+
+Put anything at all in this file and `store.prompt_sha` changes, reuse drops to zero, and
+one pass over the 76 families costs ~7,800 fresh agent rollouts.
