@@ -0,0 +1,58 @@
+# visqa: the data_split visual-QA families (this study).
+#   * rollouts come from the shared code-interpreter executor, not from a chat backend,
+#     so `model.target*` is unused here; the optimizer role runs gemini-3.1-pro over the SDK;
+#   * SINGLE PASS: `batch_size: 0` makes the family's train set one batch, so the run is
+#     exactly one rollout -> reflect -> aggregate -> rewrite -> accept.  The initial skill
+#     is empty, which makes that one rollout pass reusable from the acq pool (see
+#     skillopt/envs/visqa/skills/README.md);
+#   * no held-out validation set: the driver points val/ at the family's own train records,
+#     `use_gate: false` force-accepts every edit and `sel_env_num: 0` switches the selection
+#     rollouts off -- with the gate disabled they only produced a number nobody reads;
+#   * `env.split_dir` and `env.image_root` are set per family by drivers/run_skillopt.py.
+_base_: ../_base_/default.yaml
+
+model:
+  optimizer_backend: gemini_chat
+  target_backend: gemini_chat
+  optimizer: gemini-3.1-pro-preview
+  target: gemini-3.1-pro-preview
+  reasoning_effort: medium
+
+train:
+  num_epochs: 1            # one pass over the family = the study's per-family budget
+  batch_size: 0            # 0 = the whole train split in one step (single pass)
+  accumulation: 1
+  seed: 42
+
+gradient:
+  minibatch_size: 8
+  merge_batch_size: 8
+  analyst_workers: 8
+
+optimizer:
+  learning_rate: 4
+  # Both are epoch>=2 machinery and no-ops at num_epochs=1, but each costs 2 x 20 x 4 fresh
+  # agent rollouts per extra epoch (prev-skill vs current-skill on a resampled train batch).
+  # Pinned off so raising --epochs cannot quietly multiply the bill.
+  use_slow_update: false
+  use_meta_skill: false
+
+evaluation:
+  use_gate: false          # accept every edit
+  sel_env_num: 0           # 0 = no selection rollouts at all (the gate is off anyway)
+  test_env_num: 0
+  eval_test: false         # the held-out split is never scored from inside SkillOpt
+
+env:
+  name: visqa
+  skill_init: skillopt/envs/visqa/skills/initial.md
+  split_mode: split_dir
+  split_dir: ""
+  image_root: ""
+  data_path: ""
+  split_output_dir: ""
+  max_turns: 20
+  rollouts: 4              # protocol: 4 rollouts per task while training
+  max_completion_tokens: 8192
+  workers: 8
+  limit: 0
