diff --git a/skillopt/model/gemini_backend.py b/skillopt/model/gemini_backend.py
new file mode 100644
index 0000000..a261924
--- /dev/null
+++ b/skillopt/model/gemini_backend.py
@@ -0,0 +1,113 @@
+"""Gemini chat backend (`gemini_chat`) on the google-genai SDK.
+
+SkillOpt ships OpenAI / Azure / Claude / Qwen / MiniMax / generic OpenAI-compatible
+backends.  This study runs every model call on gemini-3.1-pro through Google's own SDK, so
+this module implements the backend contract (`chat_optimizer`, `chat_target`, their
+`*_messages` variants, `count_tokens`) on top of the shared wrapper in
+`baselines/common/gemini.py`.
+
+In the visqa environment only the *optimizer* role goes through here: the target rollouts
+are produced by the shared executor (see `skillopt/envs/visqa/rollout.py`), so every method
+in the study shares one agent and one judge.  The target functions are implemented anyway,
+so the backend also works for text-only benchmarks.
+"""
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+from typing import Any
+
+from skillopt.model.common import TokenTracker
+
+BACKEND_NAME = "gemini_chat"
+DEFAULT_MODEL = "gemini-3.1-pro-preview"
+
+tracker = TokenTracker()
+
+_BASELINES = Path(__file__).resolve().parents[3].parent          # .../verifier/baselines
+if str(_BASELINES) not in sys.path:
+    sys.path.insert(0, str(_BASELINES))
+
+
+def _lm(role: str, max_tokens: int, timeout: float | None):
+    from common.gemini import Gemini
+    model = (os.environ.get(f"{role.upper()}_GEMINI_MODEL")
+             or os.environ.get("GEMINI_MODEL") or DEFAULT_MODEL)
+    temp = float(os.environ.get("GEMINI_TEMPERATURE", "0.6"))
+    return Gemini(model=model, temperature=temp, max_tokens=max_tokens,
+                  timeout_s=float(timeout or 600.0))
+
+
+def _record(lm, stage: str) -> dict[str, int]:
+    u = lm.usage
+    tracker.record(stage, int(u.get("in_tokens", 0)), int(u.get("out_tokens", 0)))
+    return {"prompt_tokens": int(u.get("in_tokens", 0)),
+            "completion_tokens": int(u.get("out_tokens", 0)),
+            "total_tokens": int(u.get("in_tokens", 0)) + int(u.get("out_tokens", 0))}
+
+
+def _chat(messages: list[dict[str, Any]], max_completion_tokens: int, stage: str, role: str,
+          timeout: float | None = None) -> tuple[str, dict[str, int]]:
+    lm = _lm(role, max_completion_tokens, timeout)
+    text = lm.generate(messages)
+    return text, _record(lm, stage)
+
+
+def chat_optimizer(system: str, user: str, max_completion_tokens: int = 16384, retries: int = 5,
+                   stage: str = "optimizer", reasoning_effort: str | None = None,
+                   timeout: float | None = None) -> tuple[str, dict[str, int]]:
+    del retries, reasoning_effort
+    return _chat([{"role": "system", "content": system}, {"role": "user", "content": user}],
+                 max_completion_tokens, stage, "optimizer", timeout)
+
+
+def chat_target(system: str, user: str, max_completion_tokens: int = 16384, retries: int = 5,
+                stage: str = "target", reasoning_effort: str | None = None,
+                timeout: float | None = None) -> tuple[str, dict[str, int]]:
+    del retries, reasoning_effort
+    return _chat([{"role": "system", "content": system}, {"role": "user", "content": user}],
+                 max_completion_tokens, stage, "target", timeout)
+
+
+def chat_optimizer_messages(messages: list[dict[str, Any]], max_completion_tokens: int = 16384,
+                            retries: int = 5, stage: str = "optimizer",
+                            reasoning_effort: str | None = None, *,
+                            tools: list[dict[str, Any]] | None = None,
+                            tool_choice: Any = None, return_message: bool = False,
+                            timeout: float | None = None) -> tuple[Any, dict[str, int]]:
+    del retries, reasoning_effort, tool_choice
+    if tools:
+        raise NotImplementedError("gemini_chat does not expose provider tool calling; "
+                                  "the visqa environment gets its tools from the shared executor")
+    text, usage = _chat(messages, max_completion_tokens, stage, "optimizer", timeout)
+    if return_message:
+        from skillopt.model.common import CompatAssistantMessage
+        return CompatAssistantMessage(content=text, tool_calls=[]), usage
+    return text, usage
+
+
+def chat_target_messages(messages: list[dict[str, Any]], max_completion_tokens: int = 16384,
+                         retries: int = 5, stage: str = "target",
+                         reasoning_effort: str | None = None, *,
+                         tools: list[dict[str, Any]] | None = None, tool_choice: Any = None,
+                         return_message: bool = False,
+                         timeout: float | None = None) -> tuple[Any, dict[str, int]]:
+    del retries, reasoning_effort, tool_choice
+    if tools:
+        raise NotImplementedError("gemini_chat does not expose provider tool calling")
+    text, usage = _chat(messages, max_completion_tokens, stage, "target", timeout)
+    if return_message:
+        from skillopt.model.common import CompatAssistantMessage
+        return CompatAssistantMessage(content=text, tool_calls=[]), usage
+    return text, usage
+
+
+def count_tokens(text: str, model: str | None = None) -> int:
+    """Character-based estimate (the SDK's counter needs a call; this is only used for budgets)."""
+    del model
+    return max(1, len(str(text or "")) // 4)
+
+
+def get_max_tokens() -> int:
+    return int(os.environ.get("GEMINI_MAX_TOKENS", "16384"))
